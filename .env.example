# Configure this in Vercel Project Settings -> Environment Variables.
# Never commit the real value.
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Username login server settings (Vercel Environment Variables).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
# Secret: copy only into Vercel, never into browser JavaScript.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
